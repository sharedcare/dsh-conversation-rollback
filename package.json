{
  "name": "conversation-rollback",
  "version": "1.5.1",
  "description": "Codex-style in-place conversation rollback and edit-and-resend for the DeepSeek Harness web GUI, plus a right-edge outline rail (session table of contents, switchable from Settings) whose search pages backwards through history until it matches",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node tools/merge-client.mjs",
    "build:strip": "node tools/merge-client.mjs --strip",
    "test": "node --check lib/chunk-rows.js && node --check lib/client.js && node --check lib/index.js && node test/chunk-rows.mjs && node test/host-route.mjs && node test/smoke.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./chunk-rows": "./lib/chunk-rows.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/chunk-rows.js",
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sharedcare/dsh-conversation-rollback.git"
  },
  "bugs": {
    "url": "https://github.com/sharedcare/dsh-conversation-rollback/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "conversation",
    "rollback"
  ]
}
